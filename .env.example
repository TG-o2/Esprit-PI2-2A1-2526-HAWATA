# Example environment variables for Hawata

# Database (Oracle preferred)
HWT_DB_USER=qtuser
HWT_DB_PASSWORD=mypassword123
HWT_DB_HOST=localhost
HWT_DB_PORT=1521
HWT_DB_SERVICE=XE

# ODBC fallback
HWT_DB_DSN=HWT
# HWT_DB_CONNECT=localhost:1521/XE

# Oracle Instant Client directory (optional)
# HWT_ORACLE_CLIENT_DIR=C:/oracle/instantclient

# Ollama / AI fallback (optional)
OLLAMA_HOST=http://localhost:11434

# Additional runtime flags
HWT_LOG_LEVEL=info



